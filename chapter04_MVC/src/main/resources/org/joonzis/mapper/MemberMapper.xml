<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="org.joonzis.mapper.MemberMapper">

	<resultMap type="org.joonzis.domain.MemberVO" id="memberMap">
		<result property="userId"  column="userId" />
		<result property="userPw"  column="userPw" />
		<result property="userName"  column="userName" />
		<result property="regDate"  column="regDate" />
		<result property="updateDate"  column="updateDate" />
		<collection property="authList" resultMap="authMap"></collection>
	
	</resultMap>


	<resultMap type="org.joonzis.domain.AuthVO" id="authMap">
		<result property="userId"  column="userId" />
		<result property="auth"  column="auth" />
	
	</resultMap>


	<select id="read"  resultMap="memberMap">
		select mem.*,auth.auth
		from tbl_member mem LEFT JOIN tbl_member_auth auth
		on mem.userId = auth.userId
		where mem.userId= #{userId}
		
	</select>

	<insert id="register">
	
	    INSERT INTO tbl_member
	        (userId, userPw, userName, regDate, upDatedate)
	    VALUES
	        (#{userId}, #{userPw}, #{userName}, SYSDATE, SYSDATE)
	
	</insert>

	<insert id="registerAuth">
	    INSERT INTO tbl_member_auth
	        (userId, auth)
	    VALUES
	        (#{userId}, 'ROLE_USER')
	</insert>

</mapper>
