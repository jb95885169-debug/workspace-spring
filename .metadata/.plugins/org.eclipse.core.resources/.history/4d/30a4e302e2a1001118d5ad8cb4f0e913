package org.joonzis.DI_6_annoConfig;

import java.util.HashSet;
import java.util.Set;

import org.springframework.context.annotation.Bean;
import org.springframework.context.annotation.Configuration;

/*
 *  sts 3버전에서는 해당 프로젝트에 CGLIB라이브러리 추가
 * 	
 * 
 * */

@Configuration // applicationContext와 같은 역할을 하는 자바 클래스
public class AnnoConfig {
	@Bean // Bean 을 만드는 메소드
	public Person human1() {
		// <bean od = "human1" class= ">
		Set<String> hobbies = new HashSet<String>();
		hobbies.add("여행");
		hobbies.add("게임");
		hobbies.add("축구");
		
		Person person = new Person();
		person.setName("김씨");
		person.setAge(30);
		person.setHobbies(hobbies);
		
		return person;
	}
		@Bean(name="human2") // Bean 을 만드는 메소드
		public Person human2() {
			// <bean id = "human2" class= "PersonInfo.java경로">
			Set<String> hobbies = new HashSet<String>();
			hobbies.add("여행");
			hobbies.add("게임");
			hobbies.add("축구");
			
			Person person = new Person();
			person.setName("김씨");
			person.setAge(30);
			person.setHobbies(hobbies);
			
			return person;
		
		
	}
}
