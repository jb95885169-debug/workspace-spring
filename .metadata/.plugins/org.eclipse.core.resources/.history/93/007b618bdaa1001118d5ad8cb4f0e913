package org.joonzis.DI_5_set;

public class SamsungTV implements TV{
	
	// SamsungTV의 볼륨 조절 기능은 SonySpeaker를 사용한다
	private SonySpeaker sonySpeaker;
	
	public SamsungTV() {
		System.out.println("--> SamsungTV 객체(1)생성");
	}
	public SamsungTV(SonySpeaker sonySpeaker) {
		System.out.println("--> SamsungTV 객체(2) 생성");
		this.sonySpeaker = sonySpeaker;
	}
	@Override
	public void powerOn() {
		System.out.println("--> SamsungTV 전원 켠다");
	}
	@Override
	public void powerOff() {
		System.out.println("--> SamsungTV 전원 끈다");
	}
	@Override
	public void volumeUp() {
		sonySpeaker.volumeUp();
	}
	@Override
	public void volumeDown() {
		sonySpeaker.volumeDown();
	
}
}
